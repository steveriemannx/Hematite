// Hematite demo: a signature may name the return value and put an optional `=`
// before the body. Every function below writes the `=`; removing it changes
// nothing. Everything inside the braces is 100% normal Rust and there is no
// `ret` variable in scope there.
//
// The body follows idiomatic Rust: a tail expression for the value, and `return`
// only for early exits.

fn add(a: i32, b: i32) -> ret: i32 = {
    a + b
}

fn mul(a: i32, b: i32) -> r: i32 = {
    a * b
}

fn classify(x: i32) -> label: &'static str = {
    if x < 0 {
        return "negative";
    }
    "non-negative"
}

fn log(msg: &str) -> out: () = {
    println!("{msg}");
}

fn sum(xs: &[i32]) -> total: i32 = {
    let mut acc = 0;
    for x in xs {
        acc += *x;
    }
    acc
}

fn main() = {
    log("hematite demo");

    // Closures accept the same return annotations.
    let double = |x: i32| -> twice: i32 = { x * 2 };
    let describe = |n: i32| -> text: String { format!("{} doubled is {}", n, double(n)) };

    println!("add(2, 3)      = {}", add(2, 3));
    println!("mul(2, 3)      = {}", mul(2, 3));
    println!("classify(-1)   = {}", classify(-1));
    println!("classify(1)    = {}", classify(1));
    println!("sum([1,2,3,4]) = {}", sum(&[1, 2, 3, 4]));
    println!("closure        = {}", describe(21));
}
