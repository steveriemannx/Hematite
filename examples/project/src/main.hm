mod math;
mod util;

use math::add;

fn main() -> code: std::process::ExitCode = {
    let total = math::sum(&[1, 2, 3, 4]);
    println!("add(2, 3)  = {}", add(2, 3));
    println!("sum(1..4)  = {}", total);
    // Call a plain-Rust module directly.
    println!("repeat     = {}", util::repeated("hm", 3));
    println!("shout      = {}", util::shout("mixed rust + hematite"));
    std::process::ExitCode::SUCCESS
}
