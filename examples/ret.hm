// Every named return in this file is called `ret` - which is also the default
// name that `-> name: T` falls back to when `=` is written without a name.
//
// Run it with:
//     hm run examples/ret.hm

fn words(text: &str) -> ret: Vec<&str> = {
    text.split_whitespace().collect()
}

fn longest(text: &str) -> ret: &str = {
    let mut best = "";
    for word in words(text) {
        if word.len() > best.len() {
            best = word;
        }
    }
    best
}

fn initials(text: &str) -> ret: String = {
    words(text)
        .iter()
        .filter_map(|word| word.chars().next())
        .collect::<String>()
        .to_uppercase()
}

fn stats(text: &str) -> ret: (usize, usize) = {
    let ws = words(text);
    let chars = ws.iter().map(|word| word.len()).sum();
    (ws.len(), chars)
}

fn main() -> ret: std::process::ExitCode = {
    let text = "hematite is a cpp2 flavoured syntax layer for rust";
    let (count, chars) = stats(text);
    println!("text     : {text}");
    println!("words    : {count}");
    println!("chars    : {chars}");
    println!("longest  : {}", longest(text));
    println!("initials : {}", initials(text));
    std::process::ExitCode::SUCCESS
}
